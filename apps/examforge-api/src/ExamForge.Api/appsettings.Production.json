{
  "AllowedHosts": "api.examforge.io.vn",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Global": {
      "TokenLimit": 120,
      "TokensPerPeriod": 120,
      "ReplenishmentPeriodSeconds": 60,
      "AutoReplenishment": true,
      "QueueLimit": 0
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "HealthChecks": {
    "ReadinessTimeoutSeconds": 2
  },
  "Auth": {
    "AllowPublicRegistration": false
  },
  "Jwt": {
    "Issuer": "ExamForge",
    "Audience": "ExamForge.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
